bin/
obj/
*.user

# UI (Vite/React) - node_modules alone is 100MB+, never commit it
ui/node_modules/
ui/dist/
ui/.env.local

# IDE / OS
.vs/
.idea/
.DS_Store

# Corporate root CA a teammate drops into certs/ locally (see certs/README.md) - never the
# folder itself, since certs/README.md and certs/.gitkeep stay tracked, only the actual cert
# (api.Dockerfile/ollama.Dockerfile only ever look for *.crt there).
certs/*.crt
